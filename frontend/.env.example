# ── MaintChain Frontend — Environment Variables ──
# Copy to .env.local and fill in values. Client vars use NEXT_PUBLIC_ prefix.

# ── Stellar / Soroban (required) ──
NEXT_PUBLIC_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# ── Backend API (server-side only — NO NEXT_PUBLIC_ prefix) ──
# Used by the Next.js API proxy to forward requests to the Rust backend.
BACKEND_URL=http://localhost:8081
# Shared secret with the Rust backend (server-to-server auth).
MAINTCHAIN_API_KEY=
# Random secret for signing HMAC session cookies (HttpOnly).
AUTH_SECRET=

# ── Error Tracking (GlitchTip — optional in dev) ──
# Client-side DSN (exposed to browser via NEXT_PUBLIC_ prefix).
NEXT_PUBLIC_GLITCHTIP_DSN=https://d50984aebbe547c1af84ff919ccedb62@app.glitchtip.com/27052
# Server-side DSN (read by sentry.server.config.ts and sentry.edge.config.ts).
GLITCHTIP_DSN=https://d50984aebbe547c1af84ff919ccedb62@app.glitchtip.com/27052
# Legacy Sentry DSNs (optional fallback during migration — safe to leave unset).
# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_DSN=

# ── Analytics (PostHog — optional in dev) ──
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# ── App Metadata ──
NEXT_PUBLIC_APP_VERSION=

# ── Soroban Smart Contracts (required after deployment) ──
# Set after running: node scripts/deploy-contracts.mjs
NEXT_PUBLIC_EQUIPMENT_REGISTRY_ID=
NEXT_PUBLIC_MAINTENANCE_RECORDS_ID=
NEXT_PUBLIC_MULTI_PARTY_APPROVAL_ID=
NEXT_PUBLIC_COMPLIANCE_ATTESTATION_ID=
NEXT_PUBLIC_IDENTITY_REGISTRY_ID=
