# ── MaintChain Backend — Environment Variables ──
# Copy to .env and fill in values. All optional vars have sensible defaults.

# ── Database (required) ──
DATABASE_URL=postgres://maintchain:maintchain@localhost:5432/maintchain

# ── Error Tracking (GlitchTip — optional) ──
# Uses the same project DSN as the frontend (Sentry-compatible SDK).
GLITCHTIP_DSN=https://d50984aebbe547c1af84ff919ccedb62@app.glitchtip.com/27052
GLITCHTIP_ENVIRONMENT=production

# ── Authentication (required in production) ──
# Shared secret with the Next.js frontend proxy.
# If unset, all protected endpoints accept requests without authentication (dev mode).
MAINTCHAIN_API_KEY=

# ── Soroban / Stellar Contracts (required for on-chain reads) ──
# Soroban RPC endpoint
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
# Network passphrase (required for transaction building)
SOROBAN_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
# Helper script path inside Docker container
SOROBAN_HELPER_PATH=/app/scripts/soroban-invoke.mjs

# Deployed contract IDs (set after running scripts/deploy-contracts.mjs)
APPROVAL_CONTRACT_ID=
RECORDS_CONTRACT_ID=
ATTESTATION_CONTRACT_ID=
IDENTITY_REGISTRY_CONTRACT_ID=

# ── CORS ──
# Comma-separated list of allowed origins (e.g. "https://maintchain.vercel.app,http://localhost:3000")
ALLOWED_ORIGINS=http://localhost:3000

# ── Logging ──
RUST_LOG=info

# ── Server ──
# Render injects PORT automatically; defaults to 8081 if unset.
PORT=8081

# ── Database Migrations ──
# Uncomment to skip migration failures instead of panicking on startup.
# SKIP_MIGRATIONS_ON_ERROR=1

# ── IPFS / File Storage (optional) ──
# PINATA_API_KEY=
# PINATA_API_SECRET=
