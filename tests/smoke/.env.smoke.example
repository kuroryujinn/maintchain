# MaintChain Smoke Test Environment
# Copy to .env.smoke and fill in values.
# NEVER commit .env.smoke — it's in .gitignore.

# Target URL for smoke tests (required)
SMOKE_BASE_URL=https://maintchain.vercel.app
SMOKE_ENVIRONMENT=production
SMOKE_NETWORK=testnet

# Request timeout in ms
SMOKE_TIMEOUT=30000

# Enable blockchain write tests (requires SMOKE_TEST_WALLET_SECRET)
# Default: false (read-only verification only)
SMOKE_ENABLE_BLOCKCHAIN=false

# Enable analytics/telemetry configuration checks
SMOKE_ENABLE_ANALYTICS=true
SMOKE_ENABLE_TELEMETRY=true

# Stellar RPC override (defaults to testnet)
SMOKE_STELLAR_RPC_URL=https://soroban-testnet.stellar.org

# ── Testnet Wallet (for write tests) ──────────────────────
# A dedicated Stellar Testnet wallet with sufficient test XLM.
# NEVER commit this value. NEVER print it. NEVER expose to frontend.
# Use the Stellar Laboratory Friendbot to fund:
#   https://laboratory.stellar.org/#account/create
SMOKE_TEST_WALLET_SECRET=
