# ══════════════════════════════════════════════════════════════
# MaintChain .gitignore
# ══════════════════════════════════════════════════════════════

# ── Environment / Secrets ───────────────────────────────────
.env
.env.*
!.env.example
!.env.smoke.example

# ── Documentation (keep only essential Markdown) ─────────────
*.md
!README.md
!PROJECT_GUIDE.md
!STELLAR_INTEGRATION.md
!SYSTEM_DESIGN.md
!docs/ONBOARDING.md
!docs/STELLAR_TRANSACTION_FLOW_ANALYSIS.md
SYSTEM_DESIGN_DIAGRAM.html

# ── Node ────────────────────────────────────────────────────
node_modules/
.next/
dist/
build/
*.tsbuildinfo

# ── Rust ────────────────────────────────────────────────────
target/

# ── IDE / OS ────────────────────────────────────────────────
.vscode/
.idea/
*.pdb
.vercel
.worktrees/
nul
frontend/nul

# ── Logs ────────────────────────────────────────────────────
*.log

# ── Local Freebuff Database ────────────────────────────────
.freebuff/

# ── Playwright Test Artifacts ───────────────────────────────
frontend/playwright-output/
frontend/test-results/
test-results/
playwright-report/
*.trace
*.webm

# ── Generated Test Reports ──────────────────────────────────
tests/smoke/smoke-report.json
tests/smoke/blockchain-report.json
tests/smoke/playwright-report.json
frontend/playwright-report.json
frontend/bundle-report.html
frontend/lighthouse-report.json

# ── Duplicate Playwright Configs (canonical: tests/smoke/) ──
frontend/playwright.config.ts
frontend/browser-routes.browser.test.ts

# ── Root-level package files (frontend-only project) ────────
package.json
package-lock.json

# ── Generated Smoke Test Data ───────────────────────────────
tests/**/.env*
tests/**/generated/
tests/**/artifacts/

# ── Local Blockchain/Testnet Wallets ────────────────────────
testnet-wallets/
generated-wallets/
smoke-wallets/
test-wallets/
testnet-accounts/
*.secret
*.key

# ── Synthetic User Bot (non-required) ───────────────────────
# Multiple-Testnet-user bot — NOT used by CI or production verification.
# Local development utility only. Kept locally, not tracked.
scripts/synthetic-users/

# ── Non-required Test Scripts (not used by CI) ──────────────
# These are local development/testing utilities, not required for
# production verification or CI pipelines.
scripts/test-integration.mjs
scripts/test-setup.mjs
scripts/soroban-invoke.mjs
